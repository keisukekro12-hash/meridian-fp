# Claude API キー（音声の文字起こしを買い物リストに整理するのに使う）
ANTHROPIC_API_KEY=

# LINE 公式アカウント（Messaging API）の設定
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# 家族のLINEグループにボットを招待すると、グループIDがLINEに返信されるので、それをここに入れる。
# 空のときは、ボットを友だち追加した全員に一斉送信する。
LINE_GROUP_ID=

# おじいちゃんのスマホだけが使えるようにする合言葉（URLの ?key= に付けて一度開けば記憶される）
APP_PASSCODE=

# LINEの通知に出る名前
SENDER_NAME=おじいちゃん

# 1 にすると Claude を呼ばずに簡易的に分割する（開発用）
MOCK_AI=
